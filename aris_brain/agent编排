@dataclass
class AetherSpan:
    trace_id: str; span_id: str; parent_id: Optional[str] = None
    name: str = ""; start_time: float = field(default_factory=time.time)
    end_time: Optional[float] = None; attributes: Dict[str, Any] = field(default_factory=dict)
    events: List[Dict] = field(default_factory=list); status: str = "OK"

    def finish(self, status: str = "OK") -> None:
        self.end_time = time.time(); self.status = status

    def add_event(self, name: str, attributes: Dict = None) -> None:
        self.events.append({'name': name, 'timestamp': time.time(), 'attributes': attributes or {}})

    def to_dict(self) -> Dict:
        return {
            'trace_id': self.trace_id, 'span_id': self.span_id, 'parent_id': self.parent_id,
            'name': self.name, 'status': self.status,
            'duration_ms': (self.end_time - self.start_time) * 1000 if self.end_time else None,
            'attributes': self.attributes
        }

class AetherTelemetry:
    def __init__(self):
        self._spans: Dict[str, AetherSpan] = {}
        self._traces: Dict[str, List[AetherSpan]] = defaultdict(list)
        self._metrics = {
            'actor_messages_total': defaultdict(int),
            'petri_transitions_fired': defaultdict(int),
            'aaosa_claims_total': defaultdict(int),
            'topology_evolutions': 0,
            'actor_errors': defaultdict(int)
        }
        self._exporters: List[Callable] = []

    def start_span(self, name: str, trace_id: Optional[str] = None,
                   parent_id: Optional[str] = None, attributes: Dict = None) -> AetherSpan:
        trace_id = trace_id or str(uuid.uuid4())
        span_id = str(uuid.uuid4())[:16]
        span = AetherSpan(trace_id=trace_id, span_id=span_id, parent_id=parent_id,
                         name=name, attributes=attributes or {})
        self._spans[span_id] = span
        self._traces[trace_id].append(span)
        return span

    def end_span(self, span_id: str, status: str = "OK") -> None:
        if span_id in self._spans:
            self._spans[span_id].finish(status)
            for exporter in self._exporters:
                exporter(self._spans[span_id].to_dict())

    def record_metric(self, name: str, value: float, labels: Dict[str, str] = None) -> None:
        if name in self._metrics:
            if isinstance(self._metrics[name], defaultdict):
                key = json.dumps(labels or {}, sort_keys=True)
                self._metrics[name][key] += value
            else:
                self._metrics[name] += value

    def get_prometheus_metrics(self) -> str:
        lines = []
        for name, counter in self._metrics['actor_messages_total'].items():
            lines.append(f'aether_actor_messages_total{{actor=\"{name}\"}} {counter}')
        for name, counter in self._metrics['petri_transitions_fired'].items():
            lines.append(f'aether_petri_transitions_fired{{transition=\"{name}\"}} {counter}')
        lines.append(f'aether_topology_evolutions_total {self._metrics[\"topology_evolutions\"]}')
        return '\n'.join(lines)

    def get_trace_summary(self, trace_id: str) -> Dict:
        spans = self._traces.get(trace_id, [])
        return {
            'trace_id': trace_id, 'span_count': len(spans),
            'total_duration_ms': sum((s.end_time - s.start_time) * 1000 for s in spans if s.end_time),
            'spans': [s.to_dict() for s in spans]
        }

