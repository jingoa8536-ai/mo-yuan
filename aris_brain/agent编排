@dataclass
class TopologyNode:
    agent_id: str; capabilities: List[str]
    connections: Set[str] = field(default_factory=set)
    throughput: float = 0.0; error_rate: float = 0.0
    last_active: float = field(default_factory=time.time)

    def health_score(self) -> float:
        idle_penalty = min((time.time() - self.last_active) / 60, 1.0)
        return (1.0 - self.error_rate) * 0.5 + (1.0 - idle_penalty) * 0.3 + min(self.throughput / 100, 1.0) * 0.2

class MetaAgent:
    def __init__(self, actor_system: ActorSystem, aaosa: AAOSACoordinator):
        self.system = actor_system; self.aaosa = aaosa
        self.topology: Dict[str, TopologyNode] = {}
        self._evolution_interval = 30.0
        self._history: deque = deque(maxlen=1000)
        self._running = False
        self._evolution_task: Optional[asyncio.Task] = None
        self._bandit_rewards: Dict[str, float] = defaultdict(float)
        self._bandit_counts: Dict[str, int] = defaultdict(int)
        self._epsilon = 0.1

    async def start(self) -> None:
        self._running = True
        self._evolution_task = asyncio.create_task(self._evolution_loop())
        logger.info("Meta-Agent started")

    async def stop(self) -> None:
        self._running = False
        if self._evolution_task: self._evolution_task.cancel()

    async def _evolution_loop(self) -> None:
        while self._running:
            try:
                await asyncio.sleep(self._evolution_interval)
                await self._analyze_topology()
                await self._evolve_topology()
            except Exception as e: logger.error(f"Meta-Agent error: {e}")

    async def _analyze_topology(self) -> None:
        for actor_id, actor in self.system.actors.items():
            if actor_id not in self.topology:
                self.topology[actor_id] = TopologyNode(actor_id, [c.name for c in actor.capabilities])
            node = self.topology[actor_id]
            node.throughput = actor.metrics["messages_processed"]
            node.error_rate = actor.metrics["errors"] / max(actor.metrics["messages_processed"], 1)
            node.last_active = time.time()

    async def _evolve_topology(self) -> None:
        bottlenecks = [nid for nid, node in self.topology.items() if node.throughput > 50 and node.error_rate > 0.1]
        for bid in bottlenecks: await self._recruit_helper(bid)
        idle_threshold = time.time() - 300
        idle_agents = [nid for nid, node in self.topology.items() if node.last_active < idle_threshold and node.throughput < 5]
        for iid in idle_agents: logger.info(f"Meta-Agent: {iid} idle, considering retirement")

    async def _recruit_helper(self, target_id: str) -> None:
        target = self.system.actors.get(target_id)
        if not target: return
        helper_id = f"{target_id}_helper_{uuid.uuid4().hex[:6]}"
        helper = await self.system.spawn(helper_id, supervisor=target.address)
        for cap in target.capabilities: helper.register_capability(copy.deepcopy(cap))
        self.topology[helper_id] = TopologyNode(helper_id, [c.name for c in helper.capabilities], connections={target_id})
        target.children.add(helper_id)
        logger.info(f"Recruited helper {helper_id} for {target_id}")

    def select_agent(self, capability: str, candidates: List[str]) -> str:
        if not candidates: raise ValueError("No candidates")
        if random.random() < self._epsilon: return random.choice(candidates)
        best, best_score = None, -float("inf")
        for agent_id in candidates:
            if self._bandit_counts[agent_id] == 0: score = 1.0
            else:
                avg = self._bandit_rewards[agent_id] / self._bandit_counts[agent_id]
                exploration = (2 * (len(self._history) ** 0.5) / self._bandit_counts[agent_id]) ** 0.5
                score = avg + exploration
            if score > best_score: best_score, best = score, agent_id
        return best or candidates[0]

    def update_reward(self, agent_id: str, reward: float) -> None:
        self._bandit_rewards[agent_id] += reward
        self._bandit_counts[agent_id] += 1
        self._history.append({"agent_id": agent_id, "reward": reward, "timestamp": time.time()})

# ═══════════════════════════════════════════════════════════════════════════════
# ORCHESTRATION KERNEL
# ═══════════════════════════════════════════════════════════════════════════════

class OrchestrationKernel:
    def __init__(self, system: ActorSystem, net: PetriNet):
        self.system = system; self.net = net
        self._execution_engine: Optional[asyncio.Task] = None
        self._place_to_actors: Dict[str, Set[str]] = defaultdict(set)
        self._transition_bindings: Dict[str, str] = {}
        self._running = False
        self._checkpoints: List[Dict] = []
        self._checkpoint_interval = 10
        self._transition_count = 0

    def bind_transition(self, transition_id: str, actor_id: str) -> None:
        self._transition_bindings[transition_id] = actor_id

    def bind_place_to_actor(self, place_id: str, actor_id: str) -> None:
        self._place_to_actors[place_id].add(actor_id)

    async def start(self) -> None:
        self._running = True
        self._execution_engine = asyncio.create_task(self._run_loop())
        logger.info(f"Kernel started for {self.net.net_id}")

    async def stop(self) -> None:
        self._running = False
        if self._execution_engine: self._execution_engine.cancel()

    async def _run_loop(self) -> None:
        while self._running:
            enabled = await self.net.get_enabled_transitions()
            if not enabled: await asyncio.sleep(0.01); continue
            fire_tasks = [self._fire_with_actor(tid) for tid in enabled]
            results = await asyncio.gather(*fire_tasks, return_exceptions=True)
            fired = sum(1 for r in results if r is True)
            if fired > 0:
                self._transition_count += fired
                if self._transition_count % self._checkpoint_interval == 0: await self._checkpoint()
                await self._route_tokens()

    async def _fire_with_actor(self, transition_id: str) -> bool:
        actor_id = self._transition_bindings.get(transition_id)
        if actor_id:
            actor = self.system.actors.get(actor_id)
            if actor:
                await actor.send(AetherMessage(
                    msg_type=MessageType.INVOKE, sender=AetherAddress("system", "kernel"),
                    recipient=actor.address, payload={"transition": transition_id, "phase": "pre"}
                ))
        success = await self.net.fire_transition(transition_id)
        if success and actor_id:
            actor = self.system.actors.get(actor_id)
            if actor:
                await actor.send(AetherMessage(
                    msg_type=MessageType.INVOKE, sender=AetherAddress("system", "kernel"),
                    recipient=actor.address, payload={"transition": transition_id, "phase": "post"}
                ))
        return success

    async def _route_tokens(self) -> None:
        for place_id, actor_ids in self._place_to_actors.items():
            place = self.net.places.get(place_id)
            if not place or not place.tokens: continue
            while place.tokens:
                token = place.tokens[0]
                for actor_id in actor_ids:
                    actor = self.system.actors.get(actor_id)
                    if actor:
                        await actor.send(AetherMessage(
                            msg_type=MessageType.STATE_DELTA, sender=AetherAddress("system", "kernel"),
                            recipient=actor.address, payload={"place": place_id, "token": {
                                "color": token.color.value, "value": token.value, "provenance": token.provenance}}
                        ))
                place.withdraw()

    async def _checkpoint(self) -> None:
        state = {
            "timestamp": time.time(),
            "places": {pid: [{"color": t.color.value, "value": t.value} for t in place.tokens]
                      for pid, place in self.net.places.items()},
            "transitions_fired": self._transition_count
        }
        self._checkpoints.append(state)

    async def restore(self, checkpoint_idx: int = -1) -> bool:
        if not self._checkpoints or abs(checkpoint_idx) > len(self._checkpoints): return False
        state = self._checkpoints[checkpoint_idx]
        for pid, tokens in state["places"].items():
            if pid in self.net.places:
                place = self.net.places[pid]; place.tokens.clear()
                for td in tokens:
                    place.deposit(ColoredToken(color=TokenColor(td["color"]), value=td["value"]))
        self._transition_count = state["transitions_fired"]
        return True
