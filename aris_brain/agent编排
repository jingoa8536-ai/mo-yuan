### Evolution 2: LLM-Native 编排语言 (AetherLang)

```python
# ═══════════════════════════════════════════════════════════════════════════════
# EVOLUTION 2: LLM-NATIVE ORCHESTRATION LANGUAGE
# ═══════════════════════════════════════════════════════════════════════════════

from enum import Enum as PyEnum

class AetherLangType(PyEnum):
    INFER = "infer"      # LLM inference as first-class primitive
    ACT = "act"
    PAR = "par"
    SEQ = "seq"
    CHOICE = "choice"
    LOOP = "loop"
    GUARD = "guard"
    DELEGATE = "delegate"
    EMIT = "emit"
    WAIT = "wait"

@dataclass
class AetherLangExpr:
    expr_type: AetherLangType
    args: List[Any] = field(default_factory=list)
    kwargs: Dict[str, Any] = field(default_factory=dict)
    children: List[AetherLangExpr] = field(default_factory=list)
    meta: Dict[str, Any] = field(default_factory=dict)

    def __repr__(self) -> str:
        if self.expr_type == AetherLangType.INFER:
            return f"infer({self.kwargs.get('prompt', '...')[:30]}...)"
        elif self.expr_type == AetherLangType.PAR:
            return f"par({', '.join(repr(c) for c in self.children)})"
        elif self.expr_type == AetherLangType.SEQ:
            return f"seq({', '.join(repr(c) for c in self.children)})"
        return f"{self.expr_type.value}({self.args})"

class AetherLangCompiler:
    """Compile AetherLang AST to Petri Net + Actor bindings"""
    def __init__(self, system: ActorSystem):
        self.system = system
        self._net_counter = 0
        self._expr_registry: Dict[str, AetherLangExpr] = {}

    def infer(self, prompt: str, model: str = "default", 
              temperature: float = 0.7, tools: Optional[List[str]] = None) -> AetherLangExpr:
        return AetherLangExpr(
            expr_type=AetherLangType.INFER,
            kwargs={"prompt": prompt, "model": model, "temperature": temperature, "tools": tools or []},
            meta={"cost_estimate": len(prompt) * 0.001}
        )

    def par(self, *children: AetherLangExpr) -> AetherLangExpr:
        return AetherLangExpr(expr_type=AetherLangType.PAR, children=list(children))

    def seq(self, *children: AetherLangExpr) -> AetherLangExpr:
        return AetherLangExpr(expr_type=AetherLangType.SEQ, children=list(children))

    def choice(self, *children: AetherLangExpr) -> AetherLangExpr:
        return AetherLangExpr(expr_type=AetherLangType.CHOICE, children=list(children))

    def guard(self, condition: str, then_branch: AetherLangExpr, 
              else_branch: Optional[AetherLangExpr] = None) -> AetherLangExpr:
        children = [then_branch]
        if else_branch: children.append(else_branch)
        return AetherLangExpr(expr_type=AetherLangType.GUARD, args=[condition], children=children)

    def loop(self, condition: str, body: AetherLangExpr) -> AetherLangExpr:
        return AetherLangExpr(expr_type=AetherLangType.LOOP, args=[condition], children=[body])

    def compile(self, expr: AetherLangExpr, net_id: Optional[str] = None) -> Tuple[PetriNet, Dict[str, str]]:
        self._net_counter += 1
        net = PetriNet(net_id or f"aetherlang_{self._net_counter}")
        bindings: Dict[str, str] = {}
        entry_place = f"entry_{uuid.uuid4().hex[:6]}"
        exit_place = f"exit_{uuid.uuid4().hex[:6]}"
        net.add_place(entry_place, token_types={TokenColor.CONTROL})
        net.add_place(exit_place, token_types={TokenColor.CONTROL})
        self._compile_expr(expr, net, entry_place, exit_place, bindings)
        net.places[entry_place].deposit(ColoredToken(TokenColor.CONTROL, "start"))
        return net, bindings

    def _compile_expr(self, expr: AetherLangExpr, net: PetriNet, 
                     entry: str, exit: str, bindings: Dict[str, str]) -> None:
        if expr.expr_type == AetherLangType.INFER:
            self._compile_infer(expr, net, entry, exit, bindings)
        elif expr.expr_type == AetherLangType.PAR:
            self._compile_par(expr, net, entry, exit, bindings)
        elif expr.expr_type == AetherLangType.SEQ:
            self._compile_seq(expr, net, entry, exit, bindings)
        elif expr.expr_type == AetherLangType.GUARD:
            self._compile_guard(expr, net, entry, exit, bindings)
        elif expr.expr_type == AetherLangType.LOOP:
            self._compile_loop(expr, net, entry, exit, bindings)
        elif expr.expr_type == AetherLangType.CHOICE:
            self._compile_choice(expr, net, entry, exit, bindings)

    def _compile_infer(self, expr: AetherLangExpr, net: PetriNet, 
                      entry: str, exit: str, bindings: Dict[str, str]) -> None:
        tid = f"infer_{uuid.uuid4().hex[:6]}"
        actor_id = f"llm_actor_{uuid.uuid4().hex[:6]}"
        actor = asyncio.get_event_loop().run_until_complete(self.system.spawn(actor_id))
        actor.register_capability(Capability(
            name="llm_inference", confidence=0.95,
            schema={"prompt": "string", "model": "string"},
            cost_estimate=expr.meta.get("cost_estimate", 0.01)
        ))
        async def infer_action(tokens):
            prompt = expr.kwargs.get("prompt", "")
            logger.info(f"[LLM Inference] Prompt: {prompt[:50]}...")
            await asyncio.sleep(0.05)
            return [ColoredToken(TokenColor.DATA, f"inferred_result_of_{hash(prompt) % 10000}")]
        net.add_transition(PetriTransition(
            transition_id=tid, input_places={entry: 1},
            output_places={exit: lambda toks: toks}, action=infer_action
        ))
        bindings[tid] = actor_id

    def _compile_par(self, expr: AetherLangExpr, net: PetriNet,
                    entry: str, exit: str, bindings: Dict[str, str]) -> None:
        fork_tid = f"fork_{uuid.uuid4().hex[:6]}"
        branch_entries = []; branch_exits = []
        for i, child in enumerate(expr.children):
            be = f"branch_{i}_{uuid.uuid4().hex[:6]}"
            bx = f"branch_exit_{i}_{uuid.uuid4().hex[:6]}"
            net.add_place(be, token_types={TokenColor.CONTROL})
            net.add_place(bx, token_types={TokenColor.CONTROL})
            branch_entries.append(be); branch_exits.append(bx)
            self._compile_expr(child, net, be, bx, bindings)
        async def fork_action(tokens):
            return [ColoredToken(TokenColor.CONTROL, f"fork_to_{i}") for i in range(len(expr.children))]
        net.add_transition(PetriTransition(
            transition_id=fork_tid, input_places={entry: 1},
            output_places={be: lambda toks: [ColoredToken(TokenColor.CONTROL, "go")] for be in branch_entries},
            action=fork_action
        ))
        join_tid = f"join_{uuid.uuid4().hex[:6]}"
        net.add_transition(PetriTransition(
            transition_id=join_tid, input_places={bx: 1 for bx in branch_exits},
            output_places={exit: lambda toks: [ColoredToken(TokenColor.CONTROL, "joined")]}
        ))

    def _compile_seq(self, expr: AetherLangExpr, net: PetriNet,
                    entry: str, exit: str, bindings: Dict[str, str]) -> None:
        current_entry = entry
        for i, child in enumerate(expr.children):
            if i == len(expr.children) - 1: current_exit = exit
            else:
                current_exit = f"seq_mid_{i}_{uuid.uuid4().hex[:6]}"
                net.add_place(current_exit, token_types={TokenColor.CONTROL})
            self._compile_expr(child, net, current_entry, current_exit, bindings)
            current_entry = current_exit

    def _compile_guard(self, expr: AetherLangExpr, net: PetriNet,
                      entry: str, exit: str, bindings: Dict[str, str]) -> None:
        condition = expr.args[0] if expr.args else "true"
        then_entry = f"then_{uuid.uuid4().hex[:6]}"
        else_entry = f"else_{uuid.uuid4().hex[:6]}"
        net.add_place(then_entry, token_types={TokenColor.CONTROL})
        net.add_place(else_entry, token_types={TokenColor.CONTROL})
        async def decide(tokens):
            result = random.random() > 0.5
            return [ColoredToken(TokenColor.CONTROL, "then" if result else "else")]
        net.add_transition(PetriTransition(
            transition_id=f"decide_{uuid.uuid4().hex[:6]}", input_places={entry: 1},
            output_places={then_entry: lambda toks: [ColoredToken(TokenColor.CONTROL, "go")],
                          else_entry: lambda toks: [ColoredToken(TokenColor.CONTROL, "go")]},
            action=decide
        ))
        self._compile_expr(expr.children[0], net, then_entry, exit, bindings)
        if len(expr.children) > 1: self._compile_expr(expr.children[1], net, else_entry, exit, bindings)

    def _compile_loop(self, expr: AetherLangExpr, net: PetriNet,
                     entry: str, exit: str, bindings: Dict[str, str]) -> None:
        loop_entry = f"loop_entry_{uuid.uuid4().hex[:6]}"
        body_exit = f"body_exit_{uuid.uuid4().hex[:6]}"
        net.add_place(loop_entry, token_types={TokenColor.CONTROL})
        net.add_place(body_exit, token_types={TokenColor.CONTROL})
        net.add_transition(PetriTransition(
            transition_id=f"init_loop_{uuid.uuid4().hex[:6]}", input_places={entry: 1},
            output_places={loop_entry: lambda toks: [ColoredToken(TokenColor.CONTROL, "start")]}
        ))
        self._compile_expr(expr.children[0], net, loop_entry, body_exit, bindings)
        async def loop_guard(tokens):
            should_continue = random.random() > 0.3
            return [ColoredToken(TokenColor.CONTROL, "continue" if should_continue else "break")]
        net.add_transition(PetriTransition(
            transition_id=f"loop_guard_{uuid.uuid4().hex[:6]}", input_places={body_exit: 1},
            output_places={loop_entry: lambda toks: [ColoredToken(TokenColor.CONTROL, "again")],
                          exit: lambda toks: [ColoredToken(TokenColor.CONTROL, "done")]},
            action=loop_guard
        ))

    def _compile_choice(self, expr: AetherLangExpr, net: PetriNet,
                       entry: str, exit: str, bindings: Dict[str, str]) -> None:
        choice_places = []
        for i, child in enumerate(expr.children):
            cp = f"choice_{i}_{uuid.uuid4().hex[:6]}"
            net.add_place(cp, token_types={TokenColor.CONTROL})
            choice_places.append(cp)
            self._compile_expr(child, net, cp, exit, bindings)
        net.add_transition(PetriTransition(
            transition_id=f"choice_split_{uuid.uuid4().hex[:6]}", input_places={entry: 1},
            output_places={cp: lambda toks: [ColoredToken(TokenColor.CONTROL, "chosen")] for cp in choice_places}
        ))
