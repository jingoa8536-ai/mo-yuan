class ActorState(Enum):
    SPAWNED = auto(); IDLE = auto(); PROCESSING = auto()
    SUSPENDED = auto(); TERMINATED = auto(); RECOVERING = auto()

@dataclass
class Capability:
    name: str
    confidence: float = 1.0
    schema: Dict[str, Any] = field(default_factory=dict)
    cost_estimate: float = 0.0
    latency_estimate_ms: float = 0.0

    def can_handle(self, requirement: str, threshold: float = 0.7) -> bool:
        return self.confidence >= threshold

class AgentCell:
    def __init__(self, actor_id: str, host: str = "local"):
        self.actor_id = actor_id
        self.address = AetherAddress(host, actor_id)
        self.state = ActorState.SPAWNED
        self.mailbox: asyncio.Queue = asyncio.Queue(maxsize=1000)
        self.state_lock = asyncio.Lock()
        self.core_memory: Dict[str, Any] = {}
        self.working_memory: Dict[str, Any] = {}
        self.archival_memory: List[Dict] = []
        self.capabilities: List[Capability] = []
        self.claimed_tasks: Set[str] = set()
        self.supervisor: Optional[AetherAddress] = None
        self.children: Set[str] = set()
        self.max_retries = 3
        self.current_retry = 0
        self.metrics = {
            'messages_processed': 0, 'errors': 0,
            'avg_latency_ms': 0.0, 'claims_accepted': 0
        }
        self._handlers: Dict[MessageType, Callable] = {}
        self._running = False
        self._task: Optional[asyncio.Task] = None

    def register_capability(self, cap: Capability) -> None:
        self.capabilities.append(cap)

    def on(self, msg_type: MessageType, handler: Callable) -> None:
        self._handlers[msg_type] = handler

    async def send(self, message: AetherMessage) -> bool:
        try:
            message.increment_clock(self.actor_id)
            self.mailbox.put_nowait(message)
            return True
        except asyncio.QueueFull:
            logger.warning(f"Mailbox full for {self.actor_id}")
            return False

    async def _process_message(self, msg: AetherMessage) -> None:
        handler = self._handlers.get(msg.msg_type)
        if not handler:
            return
        async with self.state_lock:
            self.state = ActorState.PROCESSING
        start = time.time()
        try:
            if asyncio.iscoroutinefunction(handler):
                await handler(msg, self)
            else:
                handler(msg, self)
            self.metrics['messages_processed'] += 1
            latency = (time.time() - start) * 1000
            self.metrics['avg_latency_ms'] = (self.metrics['avg_latency_ms'] * 0.9 + latency * 0.1)
            self.current_retry = 0
        except Exception as e:
            self.metrics['errors'] += 1
            self.current_retry += 1
            logger.error(f"Actor {self.actor_id} error: {e}")
            if self.current_retry < self.max_retries:
                await asyncio.sleep(0.1 * (2 ** self.current_retry))
                await self.send(msg)
            else:
                if self.supervisor:
                    await self._escalate(msg, e)
                self.current_retry = 0
        finally:
            async with self.state_lock:
                self.state = ActorState.IDLE if self.mailbox.empty() else ActorState.PROCESSING

    async def _escalate(self, msg: AetherMessage, error: Exception) -> None:
        if not self.supervisor: return
        logger.info(f"Escalated failure from {self.actor_id} to {self.supervisor}")

    async def run(self) -> None:
        self._running = True
        async with self.state_lock:
            self.state = ActorState.IDLE
        while self._running:
            try:
                msg = await asyncio.wait_for(self.mailbox.get(), timeout=1.0)
                await self._process_message(msg)
                self.mailbox.task_done()
            except asyncio.TimeoutError:
                continue
            except Exception as e:
                logger.error(f"Actor loop error in {self.actor_id}: {e}")

    def stop(self) -> None:
        self._running = False
        if self._task:
            self._task.cancel()

class ActorSystem:
    def __init__(self, system_id: str = "aether"):
        self.system_id = system_id
        self.actors: Dict[str, AgentCell] = {}
        self._actor_lock = asyncio.Lock()
        self._running = False
        self.capability_registry: Dict[str, Set[str]] = defaultdict(set)
        self._event_bus: asyncio.Queue = asyncio.Queue()
        self._subscribers: Dict[str, List[Callable]] = defaultdict(list)

    async def spawn(self, actor_id: str, host: str = "local",
                    supervisor: Optional[AetherAddress] = None) -> AgentCell:
        async with self._actor_lock:
            if actor_id in self.actors:
                return self.actors[actor_id]
            actor = AgentCell(actor_id, host)
            if supervisor:
                actor.supervisor = supervisor
            self.actors[actor_id] = actor
            actor._task = asyncio.create_task(actor.run())
            for cap in actor.capabilities:
                self.capability_registry[cap.name].add(actor_id)
            logger.info(f"Spawned actor {actor_id}")
            return actor

    async def send(self, msg: AetherMessage) -> bool:
        if not msg.recipient: return False
        actor_id = msg.recipient.actor_id
        async with self._actor_lock:
            actor = self.actors.get(actor_id)
        if actor:
            return await actor.send(msg)
        return False

    async def broadcast(self, msg: AetherMessage, capability_filter: Optional[str] = None) -> int:
        sent = 0
        targets = set(self.actors.keys())
        if capability_filter:
            targets = self.capability_registry.get(capability_filter, set())
        for actor_id in targets:
            msg_copy = copy.deepcopy(msg)
            msg_copy.recipient = AetherAddress("local", actor_id)
            if await self.send(msg_copy):
                sent += 1
        return sent

    async def find_capable_agents(self, requirement: str,
                                   min_confidence: float = 0.7) -> List[tuple]:
        candidates = []
        for actor_id, actor in self.actors.items():
            for cap in actor.capabilities:
                if cap.can_handle(requirement, min_confidence):
                    candidates.append((actor_id, cap.confidence, cap.cost_estimate))
        candidates.sort(key=lambda x: (-x[1], x[2]))
        return candidates

