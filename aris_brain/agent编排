import kopf
import kubernetes
from kubernetes import client, config
import json
from datetime import datetime

try:
    config.load_incluster_config()
except config.ConfigException:
    config.load_kube_config()

apps_v1 = client.AppsV1Api()
core_v1 = client.CoreV1Api()
custom_api = client.CustomObjectsApi()

@kopf.on.create('aether.io', 'v1', 'agents')
def on_agent_create(spec, name, namespace, patch, **kwargs):
    """Reconcile Agent CRD: create Deployment, Service, ConfigMap"""
    runtime = spec.get('runtime', 'python')
    replicas = spec.get('replicas', 1)
    capabilities = spec.get('capabilities', [])
    resources = spec.get('resources', {})
    model_api = spec.get('modelAPI', '')
    telemetry = spec.get('telemetry', {'enabled': False})
    
    config_data = {
        'capabilities.json': json.dumps(capabilities),
        'config.yaml': f"""
runtime: {runtime}
model_api: {model_api}
telemetry:
  enabled: {telemetry.get('enabled', False)}
  endpoint: {telemetry.get('endpoint', '')}
"""
    }
    
    configmap = core_v1.create_namespaced_config_map(
        namespace=namespace,
        body=client.V1ConfigMap(
            metadata=client.V1ObjectMeta(
                name=f"{name}-config",
                owner_references=[_make_owner_ref(name, namespace, 'agents.aether.io')]
            ),
            data=config_data
        )
    )
    
    container = client.V1Container(
        name="agent",
        image=f"aether/runtime:{runtime}",
        env=[
            client.V1EnvVar(name="AETHER_AGENT_ID", value=name),
            client.V1EnvVar(name="AETHER_NAMESPACE", value=namespace),
            client.V1EnvVar(name="AETHER_CAPABILITIES", value=json.dumps(capabilities)),
        ],
        resources=client.V1ResourceRequirements(
            requests=resources.get('requests', {'memory': '256Mi', 'cpu': '100m'}),
            limits=resources.get('limits', {'memory': '1Gi', 'cpu': '1000m'})
        ),
        volume_mounts=[client.V1VolumeMount(name="config", mount_path="/etc/aether")]
    )
    
    deployment = apps_v1.create_namespaced_deployment(
        namespace=namespace,
        body=client.V1Deployment(
            metadata=client.V1ObjectMeta(
                name=name,
                owner_references=[_make_owner_ref(name, namespace, 'agents.aether.io')]
            ),
            spec=client.V1DeploymentSpec(
                replicas=replicas,
                selector=client.V1LabelSelector(match_labels={"app": name}),
                template=client.V1PodTemplateSpec(
                    metadata=client.V1ObjectMeta(labels={"app": name}),
                    spec=client.V1PodSpec(
                        containers=[container],
                        volumes=[client.V1Volume(
                            name="config",
                            config_map=client.V1ConfigMapVolumeSource(name=f"{name}-config")
                        )]
                    )
                )
            )
        )
    )
    
    patch.status['phase'] = 'Creating'
    patch.status['readyReplicas'] = 0
    return {'configmap': configmap.metadata.name, 'deployment': deployment.metadata.name}

@kopf.on.update('aether.io', 'v1', 'agents')
def on_agent_update(spec, name, namespace, old, new, patch, **kwargs):
    """Handle agent updates: scaling, capability changes"""
    old_spec = old.get('spec', {})
    new_spec = new.get('spec', {})
    
    if old_spec.get('replicas') != new_spec.get('replicas'):
        apps_v1.patch_namespaced_deployment_scale(
            name=name, namespace=namespace,
            body={'spec': {'replicas': new_spec['replicas']}}
        )
        patch.status['phase'] = 'Scaling'
    
    if old_spec.get('capabilities') != new_spec.get('capabilities'):
        core_v1.patch_namespaced_config_map(
            name=f"{name}-config", namespace=namespace,
            body={'data': {'capabilities.json': json.dumps(new_spec['capabilities'])}}
        )
        apps_v1.patch_namespaced_deployment(
            name=name, namespace=namespace,
            body={'spec': {'template': {'metadata': {
                'annotations': {'kubectl.kubernetes.io/restartedAt': datetime.utcnow().isoformat()}
            }}}}
        )
        patch.status['phase'] = 'Updating'

@kopf.on.create('aether.io', 'v1', 'agentsets')
def on_agentset_create(spec, name, namespace, patch, **kwargs):
    """Reconcile AgentSet: create agent topology"""
    topology = spec.get('topology', 'star')
    agents = spec.get('agents', [])
    
    created = []
    for agent_spec in agents:
        agent_name = f"{name}-{agent_spec['name']}"
        agent_cr = {
            'apiVersion': 'aether.io/v1',
            'kind': 'Agent',
            'metadata': {'name': agent_name, 'namespace': namespace},
            'spec': {
                'runtime': 'python',
                'capabilities': [{'name': c, 'confidence': 0.9} for c in agent_spec.get('capabilities', [])],
                'replicas': 1,
                'supervisor': f"{name}-coordinator" if agent_spec.get('role') != 'coordinator' else None
            }
        }
        custom_api.create_namespaced_custom_object(
            group='aether.io', version='v1', namespace=namespace,
            plural='agents', body=agent_cr
        )
        created.append(agent_name)
    
    patch.status['activeAgents'] = len(created)
    patch.status['healthyAgents'] = 0
    patch.status['topologyVersion'] = 1
    return {'createdAgents': created}

@kopf.on.create('aether.io', 'v1', 'workflows')
def on_workflow_create(spec, name, namespace, patch, **kwargs):
    """Reconcile Workflow: compile to Petri Net and deploy"""
    net_type = spec.get('netType', 'petri')
    places = spec.get('places', [])
    transitions = spec.get('transitions', [])
    
    patch.status['enabledTransitions'] = [t['id'] for t in transitions]
    patch.status['firedTransitions'] = 0
    patch.status['currentMarking'] = {p['id']: 0 for p in places}
    return {'netType': net_type, 'places': len(places), 'transitions': len(transitions)}

def _make_owner_ref(name, namespace, api_version):
    return client.V1OwnerReference(
        api_version=api_version, kind=name.split('-')[0].capitalize(),
        name=name, uid=uuid.uuid4().hex, controller=True, block_owner_deletion=True
    )
