# ═══════════════════════════════════════════════════════════════════════════════
# AETHER RUNTIME: Unified integration of all 4 evolution modules
# ═══════════════════════════════════════════════════════════════════════════════

class AetherRuntime:
    def __init__(self, system_id: str = "aether-prod"):
        self.system = ActorSystem(system_id)
        self.aaosa = AAOSACoordinator(self.system)
        self.meta = MetaAgent(self.system, self.aaosa)
        self.compiler = AetherLangCompiler(self.system)
        self.fdb = FoundationDBAdapter()
        self._nets: Dict[str, PetriNet] = {}
        self._kernels: Dict[str, OrchestrationKernel] = {}
        self._verifiers: Dict[str, PetriNetVerifier] = {}

    async def initialize(self) -> bool:
        await self.fdb.connect()
        await self.meta.start()
        logger.info("AetherRuntime initialized with all 4 evolution modules")
        return True

    async def deploy_workflow(self, lang_expr: AetherLangExpr, 
                             workflow_id: Optional[str] = None) -> str:
        wid = workflow_id or f"wf_{uuid.uuid4().hex[:8]}"
        
        # Step 1: Compile
        net, bindings = self.compiler.compile(lang_expr, wid)
        self._nets[wid] = net
        
        # Step 2: Formal verification
        verifier = PetriNetVerifier(net)
        is_bounded, max_bound = verifier.check_boundedness()
        is_live, issues = verifier.check_liveness()
        
        if not is_bounded:
            logger.warning(f"Workflow {wid} is unbounded!")
        if not is_live:
            logger.warning(f"Workflow {wid} has liveness issues: {issues}")
        
        self._verifiers[wid] = verifier
        
        # Step 3: Persist
        initial_marking = {pid: len(p.tokens) for pid, p in net.places.items()}
        await self.fdb.save_marking(wid, initial_marking)
        
        # Step 4: Start kernel
        kernel = OrchestrationKernel(self.system, net)
        for tid, aid in bindings.items():
            kernel.bind_transition(tid, aid)
        await kernel.start()
        self._kernels[wid] = kernel
        
        logger.info(f"Deployed workflow {wid}: bounded={is_bounded}, live={is_live}")
        return wid

    async def shutdown(self) -> None:
        for kernel in self._kernels.values(): await kernel.stop()
        await self.meta.stop()

