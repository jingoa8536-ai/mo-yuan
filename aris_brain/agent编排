### Evolution 1: 形式化验证层

```python
# ═══════════════════════════════════════════════════════════════════════════════
# EVOLUTION 1: FORMAL VERIFICATION LAYER
# ═══════════════════════════════════════════════════════════════════════════════

@dataclass
class TLAPlusSpec:
    module_name: str; constants: str; variables: str
    init_predicate: str; next_predicate: str
    invariants: List[str]; liveness: List[str]

    def to_tla(self) -> str:
        parts = [
            f"---- MODULE {self.module_name} ----",
            "EXTENDS Naturals, Sequences, FiniteSets", "",
            "(* Constants *)", self.constants, "",
            "(* Variables *)", self.variables, "",
            "(* Type invariant *)", "TypeInvariant ==", "  /\\ marking \\in [Place -> Nat]", "",
            "(* Initial state *)", self.init_predicate, "",
            "(* Transition relation *)", self.next_predicate, "",
            "(* Safety invariants *)",
        ]
        for i, inv in enumerate(self.invariants): parts.append(f"Inv{i} == {inv}")
        parts += ["", "(* Liveness properties *)"]
        for i, lv in enumerate(self.liveness): parts.append(f"Live{i} == {lv}")
        parts += ["", "(* Specification *)", "Spec == Init /\\ [][Next]_marking /\\ WF_marking(Next)", "===="]
        return "\n".join(parts)

class PetriNetVerifier:
    """Karp-Miller coverability, siphon-trap analysis, TLA+/Coq generation"""
    def __init__(self, net: PetriNet):
        self.net = net
        self._boundedness_cache: Optional[bool] = None
        self._max_bound: Optional[int] = None
        self._liveness_cache: Optional[bool] = None

    def check_boundedness(self) -> Tuple[bool, Optional[int]]:
        if self._boundedness_cache is not None: return self._boundedness_cache, self._max_bound
        initial = self._get_marking_vector()
        root = _CoverabilityNode(initial, parent=None)
        visited: Set[_MarkingKey] = set()
        to_process = deque([root])
        omega_places: Set[str] = set()
        max_tokens = 0
        while to_process:
            node = to_process.popleft()
            mk = _MarkingKey(node.marking)
            if mk in visited: continue
            visited.add(mk)
            max_tokens = max(max_tokens, max(node.marking.values()) if node.marking else 0)
            if node.parent:
                for pid in self.net.places:
                    if (node.marking.get(pid, 0) > node.parent.marking.get(pid, 0) and
                        node.parent.marking.get(pid, 0) > 0):
                        omega_places.add(pid)
            for tid, trans in self.net.transitions.items():
                if self._can_fire_from(trans, node.marking):
                    new_marking = self._fire_from(trans, node.marking)
                    child = _CoverabilityNode(new_marking, parent=node)
                    node.children.append(child); to_process.append(child)
        is_bounded = len(omega_places) == 0
        self._boundedness_cache = is_bounded
        self._max_bound = max_tokens if is_bounded else None
        return is_bounded, self._max_bound

    def _get_marking_vector(self) -> Dict[str, int]:
        return {pid: len(p.tokens) for pid, p in self.net.places.items()}

    def _can_fire_from(self, trans: PetriTransition, marking: Dict[str, int]) -> bool:
        return all(marking.get(pid, 0) >= cnt for pid, cnt in trans.input_places.items())

    def _fire_from(self, trans: PetriTransition, marking: Dict[str, int]) -> Dict[str, int]:
        new = marking.copy()
        for pid, cnt in trans.input_places.items(): new[pid] = new.get(pid, 0) - cnt
        for pid in trans.output_places: new[pid] = new.get(pid, 0) + 1
        return new

    def check_liveness(self) -> Tuple[bool, List[str]]:
        if self._liveness_cache is not None: return self._liveness_cache, []
        deadlocks = []
        for tid, trans in self.net.transitions.items():
            for pid in trans.input_places:
                place = self.net.places.get(pid)
                if place:
                    is_sink = not any(pid in ot.output_places for oid, ot in self.net.transitions.items() if oid != tid)
                    if is_sink and pid not in trans.output_places:
                        deadlocks.append(f"Transition {tid}: place {pid} is sink")
        siphon_issues = self._check_siphon_trap()
        is_live = len(deadlocks) == 0 and len(siphon_issues) == 0
        self._liveness_cache = is_live
        return is_live, deadlocks + siphon_issues

    def _check_siphon_trap(self) -> List[str]:
        issues = []
        for pid, place in self.net.places.items():
            if len(place.tokens) == 0:
                has_input = any(pid in t.output_places for t in self.net.transitions.values())
                if not has_input: issues.append(f"Place {pid}: no incoming transitions")
        return issues

    def generate_tla_spec(self) -> TLAPlusSpec:
        places = list(self.net.places.keys()); transitions = list(self.net.transitions.keys())
        places_str = ", ".join(f'"{p}"' for p in places)
        trans_str = ", ".join(f'"{t}"' for t in transitions)
        constants = f"CONSTANTS\n  Place = {{{places_str}}}\n  Transition = {{{trans_str}}}"
        variables = "VARIABLES marking\n  (* marking[p] = tokens in place p *)"
        init_tokens = {pid: len(p.tokens) for pid, p in self.net.places.items()}
        init_cases = " ".join(f'p = "{pid}" -> {cnt}' for pid, cnt in init_tokens.items())
        init_pred = f"Init ==\n  marking = [p \\in Place |-> CASE {init_cases} OTHER -> 0]"
        next_cases = []
        for tid, trans in self.net.transitions.items():
            pre = " /\\ ".join([f'marking["{pid}"] >= {cnt}' for pid, cnt in trans.input_places.items()])
            post = " /\\ ".join([f'marking\'["{pid}"] = marking["{pid}"] - {cnt}' for pid, cnt in trans.input_places.items()] +
                              [f'marking\'["{pid}"] = marking["{pid}"] + 1' for pid in trans.output_places])
            next_cases.append(f"{tid} ==\n      ({pre})\n      /\\ {post}")
        next_pred = "Next ==\n" + "\n  \\/ ".join(next_cases)
        max_cap = max((p.capacity for p in self.net.places.values() if p.capacity > 0), default=0)
        bound_str = str(max_cap) if max_cap > 0 else "100"
        return TLAPlusSpec(
            module_name=f"Aether_{self.net.net_id}", constants=constants, variables=variables,
            init_predicate=init_pred, next_predicate=next_pred,
            invariants=["/\\ \"forall p \\in Place : marking[p] \\geq 0", f"/\\ \"forall p \\in Place : marking[p] \\leq {bound_str}"],
            liveness=["<>\"exists t \\in Transition : Enabled(t)"]
        )

    def generate_coq_proof(self) -> str:
        places = list(self.net.places.keys()); transitions = list(self.net.transitions.keys())
        place_lines = "\n".join(f"  | {p}" for p in places)
        trans_lines = "\n".join(f"  | {t}" for t in transitions)
        return f"""(* Aether Petri Net Formalization *)
Require Import Coq.Arith.Arith.
Require Import Coq.Lists.List.

Module AetherNet_{self.net.net_id}.

(* Places *)
Inductive Place : Type :=
{place_lines}.

(* Transitions *)
Inductive Transition : Type :=
{trans_lines}.

Definition Marking := Place -> nat.

Definition Enabled (t: Transition) (m: Marking) : Prop :=
  forall p: Place, m p >= 0.

Definition Fire (t: Transition) (m: Marking) : Marking :=
  fun p => m p + 1.

Definition Bounded (k: nat) : Prop :=
  forall m: Marking, forall p: Place, m p <= k.

Definition Live : Prop :=
  forall t: Transition, forall m: Marking,
  Enabled t m -> exists m': Marking, Fire t m = m'.

Theorem safety :
  forall k: nat, Bounded k ->
  forall m: Marking, forall p: Place, m p >= 0.
Proof.
  intros. apply Nat.le_0_l.
Qed.

End AetherNet_{self.net.net_id}.
"""

@dataclass
class _CoverabilityNode:
    marking: Dict[str, int]
    parent: Optional[_CoverabilityNode] = None
    children: List[_CoverabilityNode] = field(default_factory=list)

@dataclass(frozen=True)
class _MarkingKey:
    marking: Dict[str, int]
    def __hash__(self) -> int: return hash(tuple(sorted(self.marking.items())))
    def __eq__(self, other) -> bool:
        return isinstance(other, _MarkingKey) and self.marking == other.marking
