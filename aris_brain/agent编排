class FaultType(Enum):
    NETWORK_DELAY = auto(); NETWORK_PARTITION = auto(); ACTOR_CRASH = auto()
    ACTOR_SLOW = auto(); MEMORY_PRESSURE = auto(); MESSAGE_DROP = auto()
    MESSAGE_DUPLICATE = auto(); CLOCK_SKEW = auto()

@dataclass
class FaultInjection:
    fault_type: FaultType
    target_actor: Optional[str] = None
    probability: float = 0.1
    duration_ms: int = 1000
    payload: Dict[str, Any] = field(default_factory=dict)

class DeterministicSimulator:
    def __init__(self, seed: int = 42):
        self.seed = seed
        self.rng = random.Random(seed)
        self._faults: List[FaultInjection] = []
        self._event_log: List[Dict] = []
        self._time_factor = 1.0
        self._deterministic_mode = True

    def add_fault(self, fault: FaultInjection) -> None:
        self._faults.append(fault)

    def should_inject(self, actor_id: str) -> Optional[FaultInjection]:
        for fault in self._faults:
            if fault.target_actor and fault.target_actor != actor_id:
                continue
            if self.rng.random() < fault.probability:
                return fault
        return None

    async def simulate_delivery(self, msg: AetherMessage, actor_id: str) -> Optional[AetherMessage]:
        fault = self.should_inject(actor_id)
        if fault:
            self._event_log.append({
                'type': 'fault_injected', 'fault': fault.fault_type.name,
                'target': actor_id, 'message': msg.msg_id, 'time': self.current_time()
            })
            if fault.fault_type == FaultType.MESSAGE_DROP:
                return None
            elif fault.fault_type == FaultType.MESSAGE_DUPLICATE:
                msg.payload['_is_duplicate'] = True
            elif fault.fault_type == FaultType.NETWORK_DELAY:
                await asyncio.sleep(fault.duration_ms / 1000.0 * self._time_factor)
            elif fault.fault_type == FaultType.ACTOR_CRASH:
                raise RuntimeError(f"Simulated crash on {actor_id}")
        self._event_log.append({
            'type': 'message_delivered', 'target': actor_id,
            'message': msg.msg_id, 'time': self.current_time()
        })
        return msg

    def current_time(self) -> float:
        if self._deterministic_mode:
            return len(self._event_log) * 0.001
        return time.time()

    def get_trace(self) -> List[Dict]:
        return self._event_log.copy()

    def assert_invariant(self, condition: bool, description: str) -> None:
        if not condition:
            raise AssertionError(f"Invariant violated: {description}")

    async def run_scenario(self, scenario: Callable, duration_seconds: float = 10.0) -> Dict:
        start = self.current_time()
        try:
            await scenario(self)
        except Exception as e:
            self._event_log.append({'type': 'scenario_failed', 'error': str(e), 'time': self.current_time()})
        elapsed = self.current_time() - start
        return {
            'seed': self.seed, 'events': len(self._event_log),
            'faults_injected': sum(1 for e in self._event_log if e['type'] == 'fault_injected'),
            'duration_simulated': elapsed,
            'passed': not any(e['type'] == 'scenario_failed' for e in self._event_log)
        }

