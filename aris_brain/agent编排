# SECTION 4: AAOSA DISTRIBUTED COORDINATOR
# ═══════════════════════════════════════════════════════════════════════════════

class AAOSACoordinator:
    def __init__(self, actor_system: ActorSystem):
        self.system = actor_system
        self._claim_store: Dict[str, List[Dict]] = {}
        self._consensus_lock = asyncio.Lock()
        self._resolution_handlers: Dict[str, Callable] = {}

    async def submit_task(self, task: Dict[str, Any], origin: AetherAddress) -> str:
        task_id = str(uuid.uuid4())
        claim_msg = AetherMessage(
            msg_type=MessageType.CLAIM,
            sender=origin,
            payload={'task_id': task_id, 'task': task, 'phase': 'evaluate', 'ttl': 3}
        )
        await self.system.broadcast(claim_msg)
        await asyncio.sleep(0.5)
        async with self._consensus_lock:
            claims = self._claim_store.get(task_id, [])
        if not claims:
            logger.warning(f"No agents claimed task {task_id}")
            return task_id
        plan = await self._resolve_claims(task_id, claims)
        await self._execute_plan(plan, origin)
        return task_id

    async def process_claim(self, msg: AetherMessage, actor: AgentCell) -> None:
        task = msg.payload.get('task', {})
        task_id = msg.payload.get('task_id')
        ttl = msg.payload.get('ttl', 0)
        if ttl <= 0: return
        matching_caps = []
        for cap in actor.capabilities:
            requirement = task.get('requirement', task.get('type', 'unknown'))
            if cap.can_handle(requirement):
                matching_caps.append(cap)
        if not matching_caps:
            if actor.children and ttl > 1:
                for child_id in actor.children:
                    child_msg = copy.deepcopy(msg)
                    child_msg.payload['ttl'] = ttl - 1
                    child_msg.recipient = AetherAddress("local", child_id)
                    await self.system.send(child_msg)
            return
        best_cap = max(matching_caps, key=lambda c: c.confidence)
        claim = {
            'agent_id': actor.actor_id, 'capability': best_cap.name,
            'confidence': best_cap.confidence, 'cost': best_cap.cost_estimate,
            'subtask_scope': {'claimed_by': best_cap.name, 'confidence': best_cap.confidence}
        }
        async with self._consensus_lock:
            if task_id not in self._claim_store:
                self._claim_store[task_id] = []
            self._claim_store[task_id].append(claim)
        actor.claimed_tasks.add(task_id)
        actor.metrics['claims_accepted'] += 1

    async def _resolve_claims(self, task_id: str, claims: List[Dict]) -> List[Dict]:
        claims.sort(key=lambda c: c['confidence'], reverse=True)
        plan = []
        covered = set()
        for claim in claims:
            agent_id = claim['agent_id']
            if agent_id not in covered:
                plan.append(claim)
                covered.add(agent_id)
        return plan

    async def _execute_plan(self, plan: List[Dict], origin: AetherAddress) -> None:
        tasks = []
        for claim in plan:
            delegate_msg = AetherMessage(
                msg_type=MessageType.DELEGATE,
                sender=origin,
                recipient=AetherAddress("local", claim['agent_id']),
                payload={'action': 'execute', 'capability': claim['capability'],
                        'context': claim.get('subtask_scope', {})}
            )
            tasks.append(self.system.send(delegate_msg))
        await asyncio.gather(*tasks, return_exceptions=True)

