{
  "_comment": "LCM Dreamshaper v7 — fast generation 4-8 steps",
  "3": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "seed": 42,
      "steps": 6,
      "cfg": 1.5,
      "sampler_name": "lcm",
      "scheduler": "sgm_uniform",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Checkpoint"},
    "inputs": {"ckpt_name": "LCM_Dreamshaper_v7_4k.safetensors"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent"},
    "inputs": {"width": 512, "height": 512, "batch_size": 1}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {"text": "a majestic dragon soaring through neon-lit cyberpunk city, rain-slicked streets reflecting purple and blue light, cinematic atmosphere, masterpiece", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {"text": "ugly, blurry, low quality, deformed, bad anatomy, watermark, text", "clip": ["4", 1]}
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"},
    "inputs": {"filename_prefix": "aris_cmft", "images": ["8", 0]}
  }
}
