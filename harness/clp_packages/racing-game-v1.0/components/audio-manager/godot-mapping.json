{
  "schema_version": "1.0",
  "component_uri": "harness://game/audio/module/engine-sound-crossfade@1.0.0#howler-webaudio",
  "godot_version": "4.7",
  "description": "Howler.js + Web Audio API 引擎声交叉淡入系统 → Godot 4.7 AudioStreamPlayer3D + AudioBusLayout + GDScript 控制器映射。3 节流阀状态 × RPM 段交叉淡入、reverb 处理链、合成 fallback 全部映射至 Godot 原生音频节点。",

  "target_resources": [
    {
      "type": "AudioStreamPlayer3D",
      "path": "res://audio/EngineSound3D.tscn",
      "node_path": "/root/AudioManager/EngineSound3D",
      "properties": {
        "stream": "res://audio/samples/911cup_offidle.ogg",
        "autoplay": false,
        "max_distance": 100.0,
        "attenuation_model": 2,
        "unit_size": 1.0,
        "max_db": 0.0,
        "bus": "Engine"
      },
      "bus": "Engine",
      "clp_source": "AudioManager.ts (Howler Web Audio)",
      "notes": "主引擎声播放器，运行时按 RPM/throttle 动态切换 stream 资源，实现 18 段交叉淡入"
    },
    {
      "type": "AudioStreamPlayer3D",
      "path": "res://audio/LimiterSound3D.tscn",
      "node_path": "/root/AudioManager/LimiterSound3D",
      "properties": {
        "stream": "res://audio/samples/911cup_limiter.ogg",
        "autoplay": false,
        "max_distance": 100.0,
        "attenuation_model": 2,
        "bus": "Engine"
      },
      "bus": "Engine",
